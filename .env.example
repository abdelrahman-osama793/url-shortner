# Copy to .env (git-ignored) and fill in the empty secrets before `docker compose up`.
# Required: POSTGRES_PASSWORD, REDIS_PASSWORD, RATE_LIMIT_SECRET, EMAIL_OUTBOX_KEY.
# Generate a value with: openssl rand -hex 24

POSTGRES_USER=shortlist
POSTGRES_DB=shortlist
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# Keys the hash that hides IPs and emails in rate-limit counters. At least 32 characters.
RATE_LIMIT_SECRET=

# Encrypts one-time tokens inside queued emails. 32 random bytes: openssl rand -base64 32
EMAIL_OUTBOX_KEY=

# Origin users open in the browser. Short URLs are built from it, and state-changing
# requests must come from it (or from ALLOWED_ORIGINS, comma-separated, if set).
PUBLIC_BASE_URL=http://localhost:4200
LOG_LEVEL=info

# Optional: Google OAuth web client ID (public, not a secret). Without it, Google sign-in is off.
# Authorized JavaScript origins in Google Cloud must include http://localhost:4200.
GOOGLE_CLIENT_ID=

# Optional click analytics settings (provisional defaults shown). TRUSTED_COUNTRY_HEADER only
# behind a proxy that sets it, e.g. cf-ipcountry; without it every country is "unknown".
# ANALYTICS_QUEUE_CAP=50000
# ANALYTICS_PUBLISH_TIMEOUT_MS=20
# TRUSTED_COUNTRY_HEADER=

# Optional session lifetimes (provisional defaults shown).
# SESSION_IDLE_MINUTES=1440
# SESSION_ABSOLUTE_HOURS=168
# ADMIN_SESSION_IDLE_MINUTES=60
# ADMIN_SESSION_ABSOLUTE_HOURS=12
# ANONYMOUS_SESSION_MINUTES=120

# Optional one-time token lifetimes (provisional defaults shown).
# VERIFICATION_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=30

# Host ports (bound to 127.0.0.1 only). Change any that clash with local services.
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6380
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
