# Copy to .env (git-ignored) and fill in the empty secrets before `docker compose up`.
# Generate a value with: openssl rand -hex 24

POSTGRES_USER=shortlist
POSTGRES_DB=shortlist
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# Origin users open in the browser. Short URLs are built from it, and state-changing
# requests must come from it (or from ALLOWED_ORIGINS, comma-separated, if set).
PUBLIC_BASE_URL=http://localhost:4200
LOG_LEVEL=info

# Host ports (bound to 127.0.0.1 only). Change any that clash with local services.
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6380
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
