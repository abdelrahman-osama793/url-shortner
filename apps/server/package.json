{
  "name": "@shortlist/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --watch src/api.js",
    "dev:worker": "node --watch src/worker.js",
    "start:api": "node src/api.js",
    "start:worker": "node src/worker.js",
    "migrate": "node-pg-migrate --migrations-dir ../../database/migrations --migrations-table pgmigrations",
    "test": "node --env-file-if-exists=../../.env --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@shortlist/contracts": "*",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^5.12.1",
    "zod": "^4.6.7"
  }
}
