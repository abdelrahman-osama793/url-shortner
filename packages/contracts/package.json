{
  "name": "@shortlist/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./openapi.json": "./openapi.json",
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./src/constants.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/openapi.js --check",
    "openapi": "node scripts/openapi.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
